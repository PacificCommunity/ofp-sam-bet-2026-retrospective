#!/bin/sh
set -eu

retro_root=$(pwd)
retro_library="$retro_root/.R-library"
retro_sources="$retro_root/.runtime-sources"
retro_host_library=$(Rscript -e 'cat(.libPaths()[1])')
mkdir -p "$retro_library" "$retro_sources"

export R_ENVIRON_USER=/dev/null
export R_PROFILE_USER=/dev/null
export R_LIBS_USER="$retro_library:$retro_host_library"

runtime_token=""
for token_name in GITHUB_PAT GIT_PAT GH_TOKEN GITHUB_TOKEN KFLOW_GITHUB_TOKEN KFLOW_PERSONAL_TOKEN; do
  eval "token_value=\${$token_name:-}"
  if [ -n "$token_value" ]; then
    runtime_token=$token_value
    break
  fi
done

runtime_askpass="$retro_root/.runtime-git-askpass"
if [ -n "$runtime_token" ]; then
  cat > "$runtime_askpass" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' x-access-token ;;
  *) printf '%s\n' "$RETRO_RUNTIME_GIT_TOKEN" ;;
esac
ASKPASS
  chmod 700 "$runtime_askpass"
fi

runtime_git() {
  if [ -n "$runtime_token" ]; then
    GIT_ASKPASS="$runtime_askpass" GIT_TERMINAL_PROMPT=0 RETRO_RUNTIME_GIT_TOKEN="$runtime_token" git "$@"
  else
    GIT_TERMINAL_PROMPT=0 git -c credential.helper= "$@"
  fi
}

install_runtime_package() {
  package=$1
  repository=$2
  revision=$3
  source_dir="$retro_sources/$package"

  if [ ! -d "$source_dir/.git" ]; then
    runtime_git clone --quiet "https://github.com/$repository.git" "$source_dir"
  fi
  runtime_git -C "$source_dir" fetch --quiet origin "$revision"
  runtime_git -C "$source_dir" checkout --quiet "$revision"
  R CMD INSTALL -l "$retro_library" "$source_dir"
}

install_cran_package() {
  package=$1
  Rscript -e "install.packages('$package', lib='$retro_library', repos='https://cloud.r-project.org')"
}

if ! Rscript -e 'quit(status=if(requireNamespace("mfclshiny", quietly=TRUE) && exists("build_retrospective_report", envir=asNamespace("mfclshiny"), inherits=FALSE)) 0L else 1L)'; then
  if ! Rscript -e 'quit(status=if(requireNamespace("iterators", quietly=TRUE)) 0L else 1L)'; then
    install_cran_package iterators
  fi
  install_runtime_package FLCore flr/FLCore 0642117cb7b66d398abc084f814c7c8b4a12dc8d
  install_runtime_package FLR4MFCL PacificCommunity/ofp-sam-flr4mfcl 3faaf84a4867175bfea50d89e4d518c085e84739
  install_runtime_package mfclkit PacificCommunity/ofp-sam-mfclkit cf786007b5261f84faac8f3d24f7084bd323119d
  install_runtime_package mfclshiny PacificCommunity/mfclshiny d76d3cebb3007c633ae64ee8f96cb75632b7d79c
fi

sha256sum -c data/SHA256SUMS
exec Rscript report/render.R
